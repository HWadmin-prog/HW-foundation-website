<!DOCTYPE html>
<html lang="en">
<script>document.documentElement.className+=" js";</script>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "OpenBMS" }}</title>
<meta name="description" content="{{ description or 'Reimagining what buildings can be with open-source controllers and equipment.' }}">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="page-scrim"></div>

<!-- CONTROLS -->
<div class="controls">
  <div class="bg-slider" title="Background image visibility">
    <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
    <input type="range" id="bgSlider" min="0" max="100" value="55" aria-label="Background image visibility">
  </div>
  <button class="theme-toggle" id="themeToggle" aria-label="Toggle light/dark theme">
    <svg class="moon" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="sun" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
  </button>
</div>

<nav>
  <div class="nav-i">
    <a href="/" class="nav-logo"><span class="mark">OB</span>OpenBMS</a>
    <ul class="nav-links">
      <li><a href="/" {% if nav=="home" %}class="active"{% endif %}>Home</a></li>
      <li><a href="/blog/" {% if nav=="blog" %}class="active"{% endif %}>Articles</a></li>
      <li><a href="/explorer/" {% if nav=="explorer" %}class="active"{% endif %}>Building Explorer</a></li>
      <li><a href="/equipment/" {% if nav=="equipment" %}class="active"{% endif %}>Equipment</a></li>
      <li><a href="/about/" {% if nav=="about" %}class="active"{% endif %}>About</a></li>
    </ul>
    <div class="nav-right">
      <a href="/shop/" class="nav-shop">Shop Satrofit</a>
      <div class="mob-btn"><span></span><span></span><span></span></div>
    </div>
  </div>
</nav>
